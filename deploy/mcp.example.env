# Copy to an untracked private file and fill locally. Never commit real values.
MAIBOT_DOCKER_NETWORK=REPLACE_WITH_EXISTING_MAIBOT_NETWORK
MLW_CAP_GATEWAY_TOKEN=REPLACE_WITH_UNIQUE_RANDOM_32_PLUS_CHARACTER_TOKEN
MLW_PIXIV_GATEWAY_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_32_PLUS_CHARACTER_TOKEN
# Relative source paths are resolved by Compose from deploy/; absolute paths also work.
CAP_SOURCE_DIR=../../cap
PIXIV_SOURCE_DIR=../../pixiv-cache-backend
# Must be the checkout containing app/mcp (currently codex/mcp-server).
PIXIV_MCP_BACKEND_URL=http://REPLACE_WITH_REACHABLE_BACKEND_SERVICE:8000
# Use an absolute path to a private file containing ONLY the existing backend API key.
PIXIV_API_KEY_FILE=/absolute/private/path/pixiv-backend-api-key
PIXIV_MCP_READ_ONLY=true
MLW_CAP_DATA_VOLUME=mailivingworld_cap_mcp_data
# Optional bounded cached-PDF page reading; does not initiate a download.
MLW_CAP_PDF_READ_ENABLED=false
# Optional existing cap file-transfer service; leave both empty to omit its tools.
JM_FILE_SERVER_URL=
JM_FILE_API_TOKEN=
JM_FILE_DOWNLOAD_BASE_URL=
