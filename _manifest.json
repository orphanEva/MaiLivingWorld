{
  "manifest_version": 2,
  "id": "local.mai-living-world",
  "version": "0.4.0",
  "name": "MaiLivingWorld · 麦麦的小世界",
  "description": "统一主动聊天、B站与RSS只读探索、A_Memorix、SQLite/MySQL去重、QQ主人识别及专属关系风格模板；默认演练模式。",
  "author": {
    "name": "Community integration / independent implementation"
  },
  "license": "MIT",
  "host_application": {
    "min_version": "1.3.10",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "PyMySQL",
      "version_spec": ">=1.1,<2.0"
    }
  ],
  "plugin_type": "integration",
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "display": {
    "icon": {
      "type": "emoji",
      "value": "🐟"
    }
  },
  "capabilities": [
    "chat.get_stream_by_user_id",
    "chat.get_stream_by_group_id",
    "message.get_by_time_in_chat",
    "message.get_recent",
    "message.build_readable",
    "llm.generate",
    "maisaka.proactive.trigger",
    "memory.ingest_summary"
  ]
}
