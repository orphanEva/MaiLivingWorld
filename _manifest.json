{
  "manifest_version": 2,
  "id": "local.mai-living-world",
  "version": "0.30.0",
  "name": "MaiLivingWorld · 麦麦的小世界",
  "description": "唯一主人的长期伴侣。能记住相处经历、看图和短片，通过 MCP 查新闻、读百科和作品，也可用独立 Mastodon 账号参与公开讨论。",
  "author": {
    "name": "Community integration / independent implementation",
    "url": "https://github.com/orphanEva"
  },
  "license": "MIT",
  "host_application": {
    "min_version": "1.3.10",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "PyMySQL",
      "version_spec": ">=1.1,<2.0"
    },
    {
      "type": "python_package",
      "name": "mcp",
      "version_spec": ">=1.28.1,!=2.0.*,!=2.1.*,!=2.2.*,<3"
    },
    {
      "type": "python_package",
      "name": "jsonschema",
      "version_spec": ">=4,<5"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10,<13"
    },
    {
      "type": "python_package",
      "name": "imageio-ffmpeg",
      "version_spec": ">=0.6,<1"
    }
  ],
  "plugin_type": "integration",
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "display": {
    "icon": {
      "type": "emoji",
      "value": "🐟"
    }
  },
  "capabilities": [
    "chat.get_stream_by_user_id",
    "chat.get_stream_by_group_id",
    "message.get_by_time_in_chat",
    "message.get_recent",
    "message.build_readable",
    "llm.generate",
    "api.call",
    "maisaka.proactive.trigger"
  ],
  "urls": {
    "repository": "https://github.com/orphanEva/MaiLivingWorld",
    "homepage": "https://github.com/orphanEva/MaiLivingWorld",
    "documentation": "https://github.com/orphanEva/MaiLivingWorld#readme",
    "issues": "https://github.com/orphanEva/MaiLivingWorld/issues"
  }
}
